rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 성취기준: 누구나 볼 수 있어야 함(로그인 전 대시보드), 수정은 로그인한 사용자만
    match /standards/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 문항: 누구나 풀어볼 수 있어야 함, 수정/삭제는 로그인한 사용자만
    match /questions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 필수탐구활동 (예전 데이터, 현재 프론트엔드에서는 사용하지 않지만 읽기는 유지)
    match /inquiry_activities/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 필수탐구활동 활동지 (AI 창작): 누구나 볼 수 있어야 함, 생성/수정은 로그인한 사용자만
    match /inquiry_worksheets/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 사용자 개인정보(API Key 등): 본인만 읽고 쓸 수 있음
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 그 외 모든 컬렉션: 기본적으로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
